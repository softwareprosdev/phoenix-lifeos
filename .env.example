# Phoenix LifeOS — Environment Configuration
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to source control.

# ─── Development Mode ────────────────────────────────────────────────────────
PHOENIX_DEV_MODE=true

# ─── AI Providers (all optional — local AI via Ollama requires no key) ───────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_HOST=http://localhost:11434

# ─── Database ────────────────────────────────────────────────────────────────
# Override the default database path (leave blank to use platform default)
PHOENIX_DB_PATH=

# ─── Logging ─────────────────────────────────────────────────────────────────
# Options: error, warn, info, debug, trace
RUST_LOG=phoenix_lifeos=info,sqlx=warn

# ─── Sync (optional — local backup is always available) ──────────────────────
PHOENIX_SYNC_ENABLED=false
PHOENIX_SYNC_ENDPOINT=
